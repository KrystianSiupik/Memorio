# Configuration of the API and the worker on the stage 1 server: copy to app.env (MEM-E0-PLAT-18). Every
# variable is described in the repository README ("Configuration, health, container").
AppVersion__Minimum=0.1.0
Messaging__ConnectionString=Host=postgres;Database=memorio;Username=memorio_messaging;Maximum Pool Size=20;Timeout=5;Password=
Account__ConnectionString=Host=postgres;Database=memorio;Username=memorio_account;Maximum Pool Size=10;Timeout=5;Password=
Plans__ConnectionString=Host=postgres;Database=memorio;Username=memorio_plans;Maximum Pool Size=5;Timeout=5;Password=
AiNarration__ConnectionString=Host=postgres;Database=memorio;Username=memorio_ai_narration;Maximum Pool Size=5;Timeout=5;Password=
Provenance__ConnectionString=Host=postgres;Database=memorio;Username=memorio_provenance;Maximum Pool Size=5;Timeout=5;Password=
Places__ConnectionString=Host=postgres;Database=memorio;Username=memorio_places;Maximum Pool Size=5;Timeout=5;Password=
Limits__ConnectionString=Host=postgres;Database=memorio;Username=memorio_limits;Maximum Pool Size=5;Timeout=5;Password=
Access__ConnectionString=Host=postgres;Database=memorio;Username=memorio_access;Maximum Pool Size=5;Timeout=5;Password=
Succession__ConnectionString=Host=postgres;Database=memorio;Username=memorio_succession;Maximum Pool Size=5;Timeout=5;Password=
Moderation__ConnectionString=Host=postgres;Database=memorio;Username=memorio_moderation;Maximum Pool Size=5;Timeout=5;Password=
# Outgoing mail; without a host messages are only logged (D-265). Scaleway: smtp.tem.scaleway.com, port 587, user = project id, password = API secret key.
#Notifications__Smtp__Host=smtp.tem.scaleway.com
#Notifications__Smtp__Port=587
#Notifications__Smtp__Username=
#Notifications__Smtp__Password=
#Notifications__Smtp__From=
#Notifications__Smtp__AppUrl=
Notifications__ConnectionString=Host=postgres;Database=memorio;Username=memorio_notifications;Maximum Pool Size=5;Timeout=5;Password=
Album__ConnectionString=Host=postgres;Database=memorio;Username=memorio_album;Maximum Pool Size=5;Timeout=5;Password=
Archive__ConnectionString=Host=postgres;Database=memorio;Username=memorio_archive;Maximum Pool Size=5;Timeout=5;Password=
Scheduling__ConnectionString=Host=postgres;Database=memorio;Username=memorio_scheduler;Maximum Pool Size=15;Timeout=5;Password=
Account__Google__ClientIds__0=
Account__Apple__ClientIds__0=
Storage__Endpoint=https://s3.eu-provider.example
Storage__Region=eu-central
Storage__Bucket=memorio-media
Storage__AccessKey=
Storage__SecretKey=
