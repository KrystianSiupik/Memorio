# Compose variables of the stage 1 application server: copy to .env (MEM-E0-PLAT-18 keeps the real file).
MEMORIO_REGISTRY=ghcr.io/<owner>               # release images (CI job release, D-171); docker login once with a read-only token
MEMORIO_VERSION=0.1.0                           # release tag of memorio-api, memorio-worker, memorio-postgres
MEMORIO_ENVIRONMENT=production                  # sent with metrics and logs
MEMORIO_DOMAIN=api.example.org                  # public name of the API (certificate, nginx)
MONITORING_IP=10.0.0.3                          # monitoring server, private network: may read /internal/worker/ready
PRIVATE_IP=10.0.0.2                             # this server's private network address: collector and node exporter listen here only
LOKI_OTLP_ENDPOINT=http://10.0.0.3:3100/otlp    # Loki on the monitoring server
# Backups (QS2): a bucket in the EU other than the media bucket, credentials that reach only it.
BACKUP_S3_PREFIX=s3://memorio-backups/postgres
BACKUP_S3_ENDPOINT=https://s3.eu-provider.example
BACKUP_S3_REGION=eu-central
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_ENCRYPTION_KEY=                          # 64 hex characters (openssl rand -hex 32); lose it and the backups are unreadable
# PostgreSQL (PLAT-21, D-182): values for a server with 4 GB of RAM; set them from the RAM of the chosen server.
# The pools in app.env, for both hosts together, must stay under POSTGRES_MAX_CONNECTIONS minus 20 (CI checks it).
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=1GB                     # about 25% of RAM
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB               # about 75% of RAM: a planner hint, nothing is allocated
POSTGRES_WORK_MEM=4MB                           # per sort or hash, per connection: keep it small with many connections
POSTGRES_MAINTENANCE_WORK_MEM=256MB             # index builds, vacuum
