{
  "openapi": "3.1.1",
  "info": {
    "title": "Memorio API",
    "version": "v1"
  },
  "paths": {
    "/v1/app/version-policy": {
      "get": {
        "tags": [
          "App"
        ],
        "summary": "Minimum app version the API serves.",
        "operationId": "GetAppVersionPolicy",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppVersionPolicyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/ai/drafts": {
      "post": {
        "tags": [
          "AI"
        ],
        "summary": "Writes a draft of a description with the AI; the id comes from the client, so a retry gets the same draft.",
        "operationId": "RequestAiDraft",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestAiDraftRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AiDraftResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/me": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "The signed-in account.",
        "operationId": "GetMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/memories": {
      "post": {
        "tags": [
          "Memories"
        ],
        "summary": "Records a memory; the id comes from the client, so a retry changes nothing.",
        "operationId": "CreateMemory",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMemoryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedMemoryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/memories/map": {
      "get": {
        "tags": [
          "Memories"
        ],
        "summary": "One point per memory the person may see; from and to (yyyy-MM-dd) filter by overlap.",
        "operationId": "GetMemoryMap",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MemoryPointResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/memories/{id}/restore": {
      "post": {
        "tags": [
          "Memories"
        ],
        "summary": "Takes the person\u0027s content back from the trash while its 30 days last.",
        "operationId": "RestoreMemory",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/v1/memories/trash": {
      "get": {
        "tags": [
          "Memories"
        ],
        "summary": "The person\u0027s own content in the trash, while its 30 days last.",
        "operationId": "GetTrash",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TrashedMemoryResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/memories/{id}/permanent-deletion": {
      "post": {
        "tags": [
          "Memories"
        ],
        "summary": "The author\u0027s formal request: the memory goes for good at once, without the trash.",
        "operationId": "RequestDataDeletion",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestDataDeletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/v1/memories/{id}": {
      "delete": {
        "tags": [
          "Memories"
        ],
        "summary": "Moves the person\u0027s content to the trash for 30 days.",
        "operationId": "TrashMemory",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      },
      "get": {
        "tags": [
          "Memories"
        ],
        "summary": "Everything about one memory the person may see.",
        "operationId": "GetMemory",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryDetailsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/memories/{id}/description": {
      "put": {
        "tags": [
          "Memories"
        ],
        "summary": "The author approves the description of a memory, naming the AI draft it started from, if any.",
        "operationId": "ApproveDescription",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveDescriptionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/v1/memories/uploads": {
      "post": {
        "tags": [
          "Memories"
        ],
        "summary": "An address to send one photo to, valid for 5 minutes.",
        "operationId": "StartPhotoUpload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/memories/{id}/photos": {
      "post": {
        "tags": [
          "Memories"
        ],
        "summary": "Adds an uploaded photo to a memory; the photo id comes from the client, so a retry changes nothing.",
        "operationId": "AddPhoto",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddPhotoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/v1/places/suggestions": {
      "get": {
        "tags": [
          "Places"
        ],
        "summary": "Places whose name starts with the text: the person\u0027s own first, then OpenStreetMap.",
        "operationId": "GetPlaceSuggestions",
        "parameters": [
          {
            "name": "text",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlaceResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/places/choice": {
      "post": {
        "tags": [
          "Places"
        ],
        "summary": "Checks the place a person chose from the suggestions and answers with it.",
        "operationId": "ChoosePlace",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChoosePlaceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/places/own": {
      "post": {
        "tags": [
          "Places"
        ],
        "summary": "Adds a place of the signed-in person\u0027s own; the id comes from the client, so a retry changes nothing.",
        "operationId": "AddOwnPlace",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddOwnPlaceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Creates an account with email and password (16\u002B declaration required) and signs in.",
        "operationId": "Register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Signs in with email and password.",
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Exchanges a refresh token for new tokens.",
        "operationId": "RefreshToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/external/{provider}": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Signs in with a Google or Apple ID token; a new account needs the 16\u002B declaration.",
        "operationId": "SignInWithProvider",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExternalSignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/terms-acceptance": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Records that the signed-in person accepted the current version of the terms.",
        "operationId": "AcceptTerms",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptTermsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/v1/account/deletion-impact": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "In numbers, what goes when the signed-in person deletes their account.",
        "operationId": "GetAccountDeletionImpact",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDeletionImpactResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/deletion": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Opens the 30-day window for deleting the account; asking again changes nothing.",
        "operationId": "RequestAccountDeletion",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestAccountDeletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDeletionResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Whether a window for deleting the account is open, and until when.",
        "operationId": "GetAccountDeletion",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDeletionResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Account"
        ],
        "summary": "Cancels the deletion of the account while its window lasts.",
        "operationId": "CancelAccountDeletion",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcceptTermsRequest": {
        "required": [
          "version"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AccessTokenResponse": {
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "tokenType": {
            "type": [
              "null",
              "string"
            ]
          },
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "AccountDeletionImpactResponse": {
        "required": [
          "memories",
          "photos",
          "ownAlbums",
          "ownAlbumsWithoutSuccessor",
          "otherPeoplesAlbums"
        ],
        "type": "object",
        "properties": {
          "memories": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "photos": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "ownAlbums": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "ownAlbumsWithoutSuccessor": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "otherPeoplesAlbums": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "AccountDeletionResponse": {
        "required": [
          "windowEndsAt"
        ],
        "type": "object",
        "properties": {
          "windowEndsAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "AccountResponse": {
        "required": [
          "accountId",
          "email",
          "acceptedTermsVersion",
          "currentTermsVersion"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "acceptedTermsVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "currentTermsVersion": {
            "type": "string"
          }
        }
      },
      "AddOwnPlaceRequest": {
        "required": [
          "id",
          "name",
          "latitude",
          "longitude"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "latitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "longitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "AddPhotoRequest": {
        "required": [
          "photoId",
          "uploadKey"
        ],
        "type": "object",
        "properties": {
          "photoId": {
            "type": "string",
            "format": "uuid"
          },
          "uploadKey": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AiDraftResponse": {
        "required": [
          "id",
          "text",
          "isAiGenerated"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string"
          },
          "isAiGenerated": {
            "type": "boolean"
          }
        }
      },
      "ApproveDescriptionRequest": {
        "required": [
          "text",
          "aiDraftId"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": [
              "null",
              "string"
            ]
          },
          "aiDraftId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "AppVersionPolicyResponse": {
        "required": [
          "minimumVersion"
        ],
        "type": "object",
        "properties": {
          "minimumVersion": {
            "type": "string"
          }
        }
      },
      "ChoosePlaceRequest": {
        "required": [
          "placeReference"
        ],
        "type": "object",
        "properties": {
          "placeReference": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreatedMemoryResponse": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateMemoryRequest": {
        "required": [
          "id",
          "placeReference",
          "datePrecision",
          "dateFrom",
          "dateTo"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "placeReference": {
            "type": [
              "null",
              "string"
            ]
          },
          "datePrecision": {
            "type": [
              "null",
              "string"
            ]
          },
          "dateFrom": {
            "type": [
              "null",
              "string"
            ]
          },
          "dateTo": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ExternalSignInRequest": {
        "required": [
          "idToken",
          "declaresMinimumAge"
        ],
        "type": "object",
        "properties": {
          "idToken": {
            "type": [
              "null",
              "string"
            ]
          },
          "declaresMinimumAge": {
            "type": "boolean"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MemoryDetailsResponse": {
        "required": [
          "id",
          "placeName",
          "latitude",
          "longitude",
          "datePrecision",
          "dateFrom",
          "dateTo",
