{
  "openapi": "3.1.1",
  "info": {
    "title": "Memorio API",
    "version": "v1"
  },
  "paths": {
    "/v1/app/version-policy": {
      "get": {
        "tags": [
          "App"
        ],
        "summary": "Minimum app version the API serves.",
        "operationId": "GetAppVersionPolicy",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppVersionPolicyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/me": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "The signed-in account.",
        "operationId": "GetMe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Creates an account with email and password (16\u002B declaration required) and signs in.",
        "operationId": "Register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Signs in with email and password.",
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Exchanges a refresh token for new tokens.",
        "operationId": "RefreshToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/external/{provider}": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Signs in with a Google or Apple ID token; a new account needs the 16\u002B declaration.",
        "operationId": "SignInWithProvider",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExternalSignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/terms-acceptance": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Records that the signed-in person accepted the current version of the terms.",
        "operationId": "AcceptTerms",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptTermsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/v1/account/deletion-impact": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "In numbers, what goes when the signed-in person deletes their account.",
        "operationId": "GetAccountDeletionImpact",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDeletionImpactResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/deletion": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Opens the 30-day window for deleting the account; asking again changes nothing.",
        "operationId": "RequestAccountDeletion",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestAccountDeletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDeletionResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Whether a window for deleting the account is open, and until when.",
        "operationId": "GetAccountDeletion",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDeletionResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcceptTermsRequest": {
        "required": [
          "version"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AccessTokenResponse": {
        "required": [
          "accessToken",
          "expiresIn",
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "tokenType": {
            "type": [
              "null",
              "string"
            ]
          },
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "AccountDeletionImpactResponse": {
        "required": [
          "memories",
          "photos",
          "ownAlbums",
          "ownAlbumsWithoutSuccessor",
          "otherPeoplesAlbums"
        ],
        "type": "object",
        "properties": {
          "memories": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "photos": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "ownAlbums": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "ownAlbumsWithoutSuccessor": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "otherPeoplesAlbums": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "AccountDeletionResponse": {
        "required": [
          "windowEndsAt"
        ],
        "type": "object",
        "properties": {
          "windowEndsAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "AccountResponse": {
        "required": [
          "accountId",
          "email",
          "acceptedTermsVersion",
          "currentTermsVersion"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "acceptedTermsVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "currentTermsVersion": {
            "type": "string"
          }
        }
      },
      "AppVersionPolicyResponse": {
        "required": [
          "minimumVersion"
        ],
        "type": "object",
        "properties": {
          "minimumVersion": {
            "type": "string"
          }
        }
      },
      "ExternalSignInRequest": {
        "required": [
          "idToken",
          "declaresMinimumAge"
        ],
        "type": "object",
        "properties": {
          "idToken": {
            "type": [
              "null",
              "string"
            ]
          },
          "declaresMinimumAge": {
            "type": "boolean"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RefreshRequest": {
        "required": [
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "password",
          "declaresMinimumAge"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          },
          "declaresMinimumAge": {
            "type": "boolean"
          }
        }
      },
      "RequestAccountDeletionRequest": {
        "required": [
          "consentsToAlbumExpiry"
        ],
        "type": "object",
        "properties": {
          "consentsToAlbumExpiry": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "App"
    },
    {
      "name": "Account"
    },
    {
      "name": "Auth"
    }
  ]
}
